# ========================================================
# CẤU HÌNH HỆ THỐNG AI AGENT SAIGON FARM RESORT
# ========================================================

# 1. FACEBOOK MESSENGER API
# Mã xác minh do bạn tự đặt (dùng khi Meta kiểm tra Webhook URL)
FB_VERIFY_TOKEN=sfr_secret_verify_token_2026

# Page Access Token lấy từ Cổng Facebook Developers -> Ứng dụng -> Messenger -> Cài đặt API
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# 2. GEMINI AI API (Hoàn toàn miễn phí mức khởi đầu tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. TELEGRAM BOT ALERT (Nhận thông báo khách & SĐT về điện thoại bạn ngay lập tức)
# Tạo bot trên Telegram qua @BotFather để lấy Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID của bạn trên Telegram (chat với @userinfobot để biết chat ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 4. CẤU HÌNH SERVER
PORT=8000
HOST=0.0.0.0
